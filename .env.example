# ==============================================================================
# IBVAP — Environment Configuration Template
# Copy this file to .env (or backend/.env) and fill in your values
# ==============================================================================

# Environment Mode: 'development' or 'production'
ENV_MODE=development

# Demo Mode: 'true' enables synthetic simulated cameras and events
DEMO_MODE=false

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==============================================================================
# Security & Encryption (CRITICAL IN PRODUCTION)
# ==============================================================================
# Cryptographically strong secret key (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ibvap-super-secret-key-replace-this-in-production-min-32-chars

# AES-256 Fernet key for encrypting camera RTSP passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=b3B2YaaAYm9yZGVyLWVuY3J5cHVpaW9uLWkuLTI0MjY=

# JWT Session Token Expiration (minutes) — 1440 = 24 hours
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite (Default for quick local / single-node deployment):
DATABASE_URL=sqlite:///./ibvap.db

# PostgreSQL (Recommended for multi-container production):
# DATABASE_URL=postgresql://ibvap_user:secure_password@localhost:5432/ibvap_production

# ==============================================================================
# Storage Directories
# ==============================================================================
STORAGE_PATH=./storage
EVIDENCE_STORAGE_PATH=./storage/evidence
TEMP_STORAGE_PATH=./storage/temp

# ==============================================================================
# Default Bootstrap Credentials
# (Used only to seed initial admin/officer accounts on first run)
# ==============================================================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminSecure@IBVAP2026!
DEFAULT_ADMIN_EMAIL=admin@ibvap.mil

DEFAULT_OFFICER_USERNAME=officer_alpha
DEFAULT_OFFICER_PASSWORD=OfficerSecure@IBVAP2026!
DEFAULT_OFFICER_EMAIL=officer.alpha@ibvap.mil

# ==============================================================================
# CORS (Allowed Frontend Origins)
# Comma-separated list of domains allowed to call the backend
# ==============================================================================
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# AI Pipeline & RTSP Performance Tuning
# ==============================================================================
MAX_AI_WORKERS=8
FRAME_SAMPLE_RATE=2
INFERENCE_QUEUE_MAX_SIZE=100
TARGET_INFERENCE_FPS=10.0
MAX_BATCH_SIZE=4
YOLO_MODEL_PATH=yolov8n.pt

# Weather integration (Optional): "none", "openweather", "station"
WEATHER_PROVIDER=none
WEATHER_API_KEY=
