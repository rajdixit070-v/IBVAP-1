# ==============================================================================
# IBVAP — Intelligent Border Video Analytics Platform Environment Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT commit .env with real credentials into source control.
# ==============================================================================

# --- Application Runtime Mode ---
ENV_MODE=development
DEMO_MODE=false
LOG_LEVEL=INFO

# --- Security & JWT Cryptography (Server-Side Only) ---
SECRET_KEY=replace-with-a-random-32-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-valid-fernet-base64-key

# --- Database Storage ---
DATABASE_URL=sqlite:///./ibvap.db

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Default Administrator Setup ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password-in-production
DEFAULT_ADMIN_EMAIL=admin@ibvap.mil

# --- Storage Directories ---
STORAGE_PATH=./storage
EVIDENCE_STORAGE_PATH=./storage/evidence
TEMP_STORAGE_PATH=./storage/temp

# --- RTSP Ingestion Tuning ---
RTSP_CONNECT_TIMEOUT_SEC=8.0
RTSP_FRAME_TIMEOUT_SEC=5.0
RECONNECT_BACKOFF_BASE=2.0
RECONNECT_MAX_DELAY_SEC=60.0
MAX_RECONNECT_ATTEMPTS=50
HEALTH_CHECK_INTERVAL_SEC=3.0

# --- AI Pipeline Tuning ---
MAX_AI_WORKERS=8
FRAME_SAMPLE_RATE=2
INFERENCE_QUEUE_MAX_SIZE=100
TARGET_INFERENCE_FPS=10.0
MAX_BATCH_SIZE=4

# --- Frontend Client Configuration (Vite Public) ---
VITE_API_URL=/api/v1
