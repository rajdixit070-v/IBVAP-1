# ==============================================================================
# IBVAP — Intelligent Border Video Analytics Platform
# Production Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (production, development, test)
ENV_MODE=development
DEMO_MODE=false
PROJECT_NAME="IBVAP — Intelligent Border Video Analytics Platform"
LOG_LEVEL=INFO

# API & Security Configuration
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-strong-random-64-character-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256 Fernet Encryption Key for Camera Credentials (base64 encoded 32 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=b3B2YaaAYm9yZGVyLWVuY3J5cHVpaW9uLWkuLTI0MjY=

# Database Configuration (SQLite for local / PostgreSQL for enterprise cluster)
# e.g., postgresql://ibvap_user:secure_password@postgres-db:5432/ibvap_prod
DATABASE_URL=sqlite:///./ibvap.db

# Storage & Evidence Directories
STORAGE_PATH=./storage
EVIDENCE_STORAGE_PATH=./storage/evidence
TEMP_STORAGE_PATH=./storage/temp

# RTSP & Ingestion Parameters
RTSP_CONNECT_TIMEOUT_SEC=8.0
RTSP_FRAME_TIMEOUT_SEC=5.0
RECONNECT_BACKOFF_BASE=2.0
RECONNECT_MAX_DELAY_SEC=60.0
MAX_RECONNECT_ATTEMPTS=50
HEALTH_CHECK_INTERVAL_SEC=3.0

# AI Pipeline & Performance Targets
MAX_AI_WORKERS=8
FRAME_SAMPLE_RATE=2
INFERENCE_QUEUE_MAX_SIZE=100
TARGET_INFERENCE_FPS=10.0
MAX_BATCH_SIZE=4

# Default Initial Administrator Setup
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@IBVAP2026
DEFAULT_ADMIN_EMAIL=admin@ibvap.mil

# Network & CORS Security
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://ibvap.mil"]
