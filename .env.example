# ====================================================================
# IBVAP — Intelligent Border Video Analytics Platform Environment Config
# ====================================================================

# Runtime Environment (development / test / production)
ENV_MODE=production
DEMO_MODE=false
LOG_LEVEL=INFO

# Application Security
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key
# 32-byte url-safe base64-encoded key for AES/Fernet encryption: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace_with_fernet_generated_key_32_bytes_base64

# Database Connection
DATABASE_URL=sqlite:///./ibvap.db
# PostgreSQL Example: postgresql://ibvap_admin:secure_password@localhost:5432/ibvap_production

# Storage Directories
STORAGE_PATH=./storage
EVIDENCE_STORAGE_PATH=./storage/evidence
TEMP_STORAGE_PATH=./storage/temp

# Camera & RTSP Stream Manager
RTSP_CONNECT_TIMEOUT_SEC=8.0
RTSP_FRAME_TIMEOUT_SEC=5.0
RECONNECT_BACKOFF_BASE=2.0
RECONNECT_MAX_DELAY_SEC=60.0
MAX_RECONNECT_ATTEMPTS=50
HEALTH_CHECK_INTERVAL_SEC=3.0

# AI Pipeline & Concurrency
MAX_AI_WORKERS=8
FRAME_SAMPLE_RATE=2
INFERENCE_QUEUE_MAX_SIZE=100
TARGET_INFERENCE_FPS=10.0
MAX_BATCH_SIZE=4

# Default Initial Administrator Bootstrap
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace_with_strong_bootstrap_password
DEFAULT_ADMIN_EMAIL=admin@ibvap.mil

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://ibvap.mil

# Frontend Environment Variables (for Vite frontend)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
