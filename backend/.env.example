# ====================================================================
# IBVAP Backend Environment Config
# ====================================================================

ENV_MODE=production
DEMO_MODE=false
LOG_LEVEL=INFO

SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key
CREDENTIAL_ENCRYPTION_KEY=b3B2YaaAYm9yZGVyLWVuY3J5cHVpaW9uLWkuLTI0MjY=

DATABASE_URL=sqlite:///./ibvap.db

STORAGE_PATH=./storage
EVIDENCE_STORAGE_PATH=./storage/evidence
TEMP_STORAGE_PATH=./storage/temp

RTSP_CONNECT_TIMEOUT_SEC=8.0
RTSP_FRAME_TIMEOUT_SEC=5.0
RECONNECT_BACKOFF_BASE=2.0
RECONNECT_MAX_DELAY_SEC=60.0
MAX_RECONNECT_ATTEMPTS=50
HEALTH_CHECK_INTERVAL_SEC=3.0

MAX_AI_WORKERS=8
FRAME_SAMPLE_RATE=2
INFERENCE_QUEUE_MAX_SIZE=100
TARGET_INFERENCE_FPS=10.0
MAX_BATCH_SIZE=4

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@IBVAP2026
DEFAULT_ADMIN_EMAIL=admin@ibvap.mil

# AI Models & Detection Weights Provisioning
# - Place pre-trained neural weights under models/ or provide absolute/relative filesystem paths.
# - If a model file is missing on disk:
#   * Backend starts normally without crashing (optional model resiliency).
#   * Camera streams connect and ingest video normally.
#   * Status reports FILE_MISSING or NOT_CONFIGURED via GET /api/v1/ai/models/status.
#   * Detections/embeddings for that model are safely omitted (never fabricated).
#   * Dashboard indicates MODEL UNAVAILABLE.
YOLO_MODEL_PATH=models/yolov8n.pt                  # Person, vehicle, animal detection (e.g. yolov8n.pt)
FACE_MODEL_PATH=models/face_recognition_sface.onnx # SFace/ArcFace ONNX biometric recognizer
DRONE_MODEL_PATH=models/yolov8_drone.pt            # Dedicated UAV/drone detector (leave empty if unprovisioned)

# Weather Intelligence Provider (Set 'none' or configure live API)
WEATHER_PROVIDER=none
WEATHER_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://ibvap.mil
